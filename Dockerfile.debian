FROM rust:1.83-slim as builder

# Install system dependencies needed for building and testing
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    clang \
    nfs-common \
    cifs-utils \
    samba-client \
    rpcbind \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy source code
COPY . .

# Build the application
RUN cargo build --release

# Create the final test image
FROM debian:12-slim

    # Install runtime dependencies for NFS and SMB mounting
    RUN apt-get update && apt-get install -y \
        nfs-common \
        cifs-utils \
        samba-client \
        rpcbind \
        mount \
        iputils-ping \
        net-tools \
        && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy the compiled binary from the builder stage
COPY --from=builder /app/target/release/fuji /usr/local/bin/

# Make the binary executable
RUN chmod +x /usr/local/bin/fuji

# Create necessary directories
RUN mkdir -p /tmp/fuji && chmod 777 /tmp/fuji

# Set up environment for privilege operations
ENV RUST_LOG=info

# Switch to root for mounting operations
USER root

# Health check to verify the binary is working
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD fuji --help || exit 1

# Default command (can be overridden in docker-compose)
CMD ["/bin/bash"]
